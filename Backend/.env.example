# =============================================================================
# The Stationery — backend environment variables
# =============================================================================
# Copy to `.env` and fill in the values. `.env` is gitignored; this example is
# committed so the required variable names are documented.
# -----------------------------------------------------------------------------

# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=development                 # development | production
PORT=8080                       # Cloud Run injects PORT; keep 8080 locally
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (the Firebase-hosted frontend).
# Never use "*" in production.
CORS_ORIGINS=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# HTTPS API gateway. Used to (1) fetch the JWKS public keys that verify frontend
# access tokens (ES256), and (2) build public avatar URLs. NOT a DB connection.
SUPABASE_URL=                   # https://<project-ref>.supabase.co
# Direct Postgres wire connection (asyncpg) via the Supavisor pooler.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Optional. Server-side secret key (sb_secret_…) — only needed later if the
# backend calls Supabase admin/Storage/REST APIs. Unused today.
# SUPABASE_SECRET_KEY=
#
# NOTE: the backend does NOT need anon/publishable/service_role keys. Auth tokens
# are verified with the project's public JWKS keys; DB access uses DATABASE_URL.
# The publishable key belongs in the FRONTEND (.env.local) for Auth + Storage.

# ── OpenRouter (LLM) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=        # optional: your site URL (OpenRouter attribution)
OPENROUTER_APP_TITLE=The Stationery

# ── Internal jobs (Cloud Scheduler → protected endpoints) ────────────────────
INTERNAL_JOB_TOKEN=           # shared secret sent as `X-Internal-Token` header

# ── LLM generation defaults (optional) ───────────────────────────────────────
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=800
