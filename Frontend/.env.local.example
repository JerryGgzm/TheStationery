# Copy to `.env.local` (gitignored) and fill in. All NEXT_PUBLIC_* vars are exposed
# to the browser — only put public, browser-safe values here.

# Supabase project (Auth + Storage). Use the TEST project for local dev.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon / publishable key (RLS still applies). NOT the service role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL, including the /api/v1 prefix.
# Local FastAPI:   http://localhost:8080/api/v1
# Cloud Run (prod): https://<service>-<hash>-<region>.run.app/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
